# DATABASE_URL: Connection string for Neon PostgreSQL (configure in Vercel Environment Variables).
# Example: postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# AUTH_SECRET: Random secret string used to sign player and admin session tokens.
AUTH_SECRET=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
